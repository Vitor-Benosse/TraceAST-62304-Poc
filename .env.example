# ==============================================================================
# TraceAST-62304 v1.0 — Environment Variables Example (.env.example - English Main)
# Versão em Português (PT-BR): ./.env.example.pt-br
# Docs (EN): ./docs/index.html | Docs (PT-BR): ./docs/index.pt-br.html
# ==============================================================================
# Static analysis (AST + Rules R01-R08 + Local RAG) runs 100% locally without
# any external API key. / O processamento estático roda 100% localmente.

# Enable optional external LLM explanations (true / false)
# Habilitar explicações complementares via LLM externo (true / false)
TRACEAST_ENABLE_LLM="false"

# Allow internal file/symbol names in the sanitized summary sent to the LLM (true / false)
# Permitir envio de nomes internos de arquivos/símbolos no resumo enviado ao LLM (true / false)
TRACEAST_ALLOW_CODE_EXCERPTS="false"

# Optional LLM provider and credentials (used only if TRACEAST_ENABLE_LLM="true")
# Provedor e credenciais opcionais para o LLM (usadas apenas se TRACEAST_ENABLE_LLM="true")
TRACEAST_LLM_PROVIDER="groq"
GROQ_API_KEY="your_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
TRACEAST_LLM_TEMPERATURE="0.1"
TRACEAST_LLM_MAX_TOKENS="800"

# RAG and Embedding Model Configuration
# Configuração do RAG e Modelo de Embeddings
TRACEAST_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
TRACEAST_EMBEDDING_MODEL_VERSION="main"
TRACEAST_USE_DENSE_EMBEDDINGS="false"
TRACEAST_RAG_DB_DIR="./db_regulacao_v1"
TRACEAST_LEGAL_DOCS_DIR="./legal_documents"

# Additional directories to exclude during scanning (comma-separated)
# Diretórios adicionais a excluir na varredura (separados por vírgula)
TRACEAST_EXCLUDE_DIRS=""
